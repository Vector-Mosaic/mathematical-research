{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "dist"
  ],
  "references": [
    {
      "path": "../../packages/codex-thread-core"
    },
    {
      "path": "../../packages/codex-remote-core"
    }
  ]
}
