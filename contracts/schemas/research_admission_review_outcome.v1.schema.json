{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectormosaic.local/schemas/mathematical_research/research_admission_review_outcome.v1.schema.json",
  "title": "Proof-Neutral Autonomous Admission Review Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "output_id", "project_id", "mission_id",
    "mission_revision", "session_id", "session_revision", "context_id",
    "context_revision", "output_contract_sha256", "case_ref",
    "candidate_ref", "review_role", "disposition", "evidence_refs",
    "blocking_objections", "findings", "non_inferences",
    "canonical_effect", "mathematical_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "research_admission_review_outcome"},
    "output_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "mission_id": {"$ref": "#/$defs/id"},
    "mission_revision": {"type": "integer", "minimum": 1},
    "session_id": {"$ref": "#/$defs/id"},
    "session_revision": {"type": "integer", "minimum": 1},
    "context_id": {"$ref": "#/$defs/id"},
    "context_revision": {"type": "integer", "minimum": 1},
    "output_contract_sha256": {"$ref": "#/$defs/sha256"},
    "case_ref": {"$ref": "#/$defs/caseReference"},
    "candidate_ref": {"$ref": "#/$defs/candidateReference"},
    "review_role": {"$ref": "#/$defs/nonEmptyString"},
    "disposition": {"enum": ["supports", "rejects"]},
    "evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/versionedReference"}
    },
    "blocking_objections": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/blockingObjection"}
    },
    "findings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "non_inferences": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "canonical_effect": {"const": "none"},
    "mathematical_effect": {"const": "none"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "caseReference": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "digest_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateReference": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "revision", "digest_sha256"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "versionedReference": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "revision", "digest_sha256"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonEmptyString"},
        "id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "blockingObjection": {
      "type": "object", "additionalProperties": false,
      "required": ["objection_id", "statement", "evidence_refs"],
      "properties": {
        "objection_id": {"$ref": "#/$defs/id"},
        "statement": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/versionedReference"}
        }
      }
    }
  }
}
