{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector-mosaic.invalid/mathematical-research/candidate-revision.v1.schema.json",
  "title": "Mathematical Research Candidate Revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "contract_schema_sha256",
    "candidate_id",
    "revision",
    "previous_revision",
    "branch_id",
    "producing_session_id",
    "producing_attempt_id",
    "author",
    "lifecycle",
    "exact_statement",
    "claimed_scope",
    "domain",
    "objects",
    "hypotheses",
    "normalizations",
    "argument_steps",
    "dependencies",
    "component_evidence_refs",
    "objections",
    "gaps",
    "circularity_risks",
    "smallest_falsifier",
    "genealogy",
    "non_inferences",
    "full_rh_case",
    "evidence_closure",
    "created_at",
    "authority_class",
    "canonical_effect",
    "admission_state"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "candidate_revision"},
    "contract_schema_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/stableId"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_revision": {"type": ["integer", "null"], "minimum": 1},
    "branch_id": {"$ref": "#/$defs/stableId"},
    "producing_session_id": {"$ref": "#/$defs/stableId"},
    "producing_attempt_id": {"$ref": "#/$defs/stableId"},
    "author": {"$ref": "#/$defs/authorPrincipal"},
    "lifecycle": {
      "enum": [
        "draft",
        "testing",
        "ready_for_independent_review",
        "falsified",
        "withdrawn"
      ]
    },
    "exact_statement": {"$ref": "#/$defs/nonemptyString"},
    "claimed_scope": {"$ref": "#/$defs/nonemptyString"},
    "domain": {"$ref": "#/$defs/nonemptyString"},
    "objects": {"$ref": "#/$defs/nonemptyUniqueStrings"},
    "hypotheses": {"$ref": "#/$defs/uniqueStrings"},
    "normalizations": {"$ref": "#/$defs/nonemptyUniqueStrings"},
    "argument_steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/argumentStep"}
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/versionedReference"}
    },
    "component_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/versionedReference"}
    },
    "objections": {"$ref": "#/$defs/uniqueStrings"},
    "gaps": {"$ref": "#/$defs/uniqueStrings"},
    "circularity_risks": {"$ref": "#/$defs/uniqueStrings"},
    "smallest_falsifier": {"$ref": "#/$defs/nonemptyString"},
    "genealogy": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/candidateReference"}
    },
    "non_inferences": {"$ref": "#/$defs/uniqueStrings"},
    "full_rh_case": {"type": "boolean"},
    "evidence_closure": {"$ref": "#/$defs/evidenceClosure"},
    "created_at": {"$ref": "#/$defs/nonemptyString"},
    "authority_class": {"const": "candidate_only"},
    "canonical_effect": {"const": "none"},
    "admission_state": {"const": "not_admitted"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,159}$"
    },
    "nonemptyString": {"type": "string", "minLength": 1},
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "authorPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "role",
        "mission_id",
        "mission_bundle_digest",
        "session_id",
        "session_plan_digest",
        "attempt_id",
        "result_digest",
        "context_digest",
        "context_manifest_sha256",
        "evidence_closure_digest"
      ],
      "properties": {
        "principal_id": {"$ref": "#/$defs/stableId"},
        "role": {"const": "candidate_author"},
        "mission_id": {"$ref": "#/$defs/stableId"},
        "mission_bundle_digest": {"$ref": "#/$defs/sha256"},
        "session_id": {"$ref": "#/$defs/stableId"},
        "session_plan_digest": {"$ref": "#/$defs/sha256"},
        "attempt_id": {"$ref": "#/$defs/stableId"},
        "result_digest": {"$ref": "#/$defs/sha256"},
        "context_digest": {"$ref": "#/$defs/sha256"},
        "context_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_closure_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "argumentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "statement",
        "justification",
        "premise_refs",
        "evidence_refs"
      ],
      "properties": {
        "step_id": {"$ref": "#/$defs/stableId"},
        "statement": {"$ref": "#/$defs/nonemptyString"},
        "justification": {"$ref": "#/$defs/nonemptyString"},
        "premise_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/versionedReference"}
        }
      }
    },
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "digest_sha256"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonemptyString"},
        "id": {"$ref": "#/$defs/stableId"},
        "revision": {"type": "integer", "minimum": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "revision", "digest_sha256"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/stableId"},
        "revision": {"type": "integer", "minimum": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closure_id", "closure_digest"],
      "properties": {
        "closure_id": {"$ref": "#/$defs/stableId"},
        "closure_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
