{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectormosaic.local/schemas/mathematical_research/research_admission_decision_outcome.v1.schema.json",
  "title": "Proof-Neutral Autonomous Admission Decision Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "decision_id", "project_id", "mission_id",
    "mission_revision", "session_id", "session_revision", "context_id",
    "context_revision", "output_contract_sha256", "case_ref",
    "candidate_ref", "review_refs", "disposition", "basis",
    "non_inferences", "canonical_effect", "mathematical_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "research_admission_decision_outcome"},
    "decision_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "mission_id": {"$ref": "#/$defs/id"},
    "mission_revision": {"type": "integer", "minimum": 1},
    "session_id": {"$ref": "#/$defs/id"},
    "session_revision": {"type": "integer", "minimum": 1},
    "context_id": {"$ref": "#/$defs/id"},
    "context_revision": {"type": "integer", "minimum": 1},
    "output_contract_sha256": {"$ref": "#/$defs/sha256"},
    "case_ref": {"$ref": "#/$defs/caseReference"},
    "candidate_ref": {"$ref": "#/$defs/candidateReference"},
    "review_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/reviewReference"}
    },
    "disposition": {"enum": ["authorize_exact_delta", "reject", "blocked"]},
    "basis": {"$ref": "#/$defs/nonEmptyString"},
    "non_inferences": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "canonical_effect": {"const": "none"},
    "mathematical_effect": {"const": "none"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "caseReference": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "digest_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateReference": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "revision", "digest_sha256"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewReference": {
      "type": "object", "additionalProperties": false,
      "required": ["review_id", "digest_sha256", "review_role", "disposition"],
      "properties": {
        "review_id": {"$ref": "#/$defs/id"},
        "digest_sha256": {"$ref": "#/$defs/sha256"},
        "review_role": {"$ref": "#/$defs/nonEmptyString"},
        "disposition": {"enum": ["supports", "rejects"]}
      }
    }
  }
}
