{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector-mosaic.invalid/mathematical-research/admission-review.v1.schema.json",
  "title": "Mathematical Research Admission Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "contract_schema_sha256",
    "review_id",
    "case_ref",
    "candidate_ref",
    "reviewer",
    "review_role",
    "disposition",
    "evidence_refs",
    "review_output_evidence",
    "review_output_closure",
    "blocking_objections",
    "findings",
    "non_inferences",
    "created_at",
    "canonical_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "admission_review"},
    "contract_schema_sha256": {"$ref": "#/$defs/sha256"},
    "review_id": {"$ref": "#/$defs/stableId"},
    "case_ref": {"$ref": "#/$defs/caseReference"},
    "candidate_ref": {"$ref": "#/$defs/candidateReference"},
    "reviewer": {"$ref": "#/$defs/reviewerPrincipal"},
    "review_role": {"$ref": "#/$defs/nonemptyString"},
    "disposition": {"enum": ["supports", "rejects"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/versionedReference"}
    },
    "review_output_evidence": {"$ref": "#/$defs/versionedReference"},
    "review_output_closure": {"$ref": "#/$defs/evidenceClosure"},
    "blocking_objections": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blockingObjection"}
    },
    "findings": {"$ref": "#/$defs/nonemptyUniqueStrings"},
    "non_inferences": {"$ref": "#/$defs/uniqueStrings"},
    "created_at": {"$ref": "#/$defs/nonemptyString"},
    "canonical_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,159}$"
    },
    "nonemptyString": {"type": "string", "minLength": 1},
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "caseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "digest_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/stableId"},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "revision", "digest_sha256"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/stableId"},
        "revision": {"type": "integer", "minimum": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewerPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "role",
        "mission_id",
        "mission_bundle_digest",
        "session_id",
        "session_plan_digest",
        "context_id",
        "attempt_id",
        "result_digest",
        "context_digest",
        "context_manifest_sha256",
        "evidence_closure_digest"
      ],
      "properties": {
        "principal_id": {"$ref": "#/$defs/stableId"},
        "role": {"const": "independent_reviewer"},
        "mission_id": {"$ref": "#/$defs/stableId"},
        "mission_bundle_digest": {"$ref": "#/$defs/sha256"},
        "session_id": {"$ref": "#/$defs/stableId"},
        "session_plan_digest": {"$ref": "#/$defs/sha256"},
        "context_id": {"$ref": "#/$defs/stableId"},
        "attempt_id": {"$ref": "#/$defs/stableId"},
        "result_digest": {"$ref": "#/$defs/sha256"},
        "context_digest": {"$ref": "#/$defs/sha256"},
        "context_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_closure_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "digest_sha256"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonemptyString"},
        "id": {"$ref": "#/$defs/stableId"},
        "revision": {"type": "integer", "minimum": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closure_id", "closure_digest"],
      "properties": {
        "closure_id": {"$ref": "#/$defs/stableId"},
        "closure_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "blockingObjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objection_id", "statement", "evidence_refs"],
      "properties": {
        "objection_id": {"$ref": "#/$defs/stableId"},
        "statement": {"$ref": "#/$defs/nonemptyString"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/versionedReference"}
        }
      }
    }
  }
}
