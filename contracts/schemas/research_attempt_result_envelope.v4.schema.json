{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectormosaic.local/schemas/mathematical_research/research_attempt_result_envelope.v4.schema.json",
  "title": "Workstation-Owned Mathematical Research Attempt Result Envelope v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "attempt_owner", "attempt_id", "attempt_chain_id",
    "attempt_sequence", "retry_of_attempt_id", "execution_intent_id", "project_id",
    "mission_id", "branch_id", "strategy_id", "context_id", "session_id",
    "semantic_work_unit_id", "configuration_id", "coordination_id",
    "coordination_digest", "authorization_id", "authorization_digest",
    "provider_fence_id", "provider_fence_digest", "provider_id",
    "provider_attempt_ref", "lifecycle", "terminal", "late", "unknown_effect",
    "provider_effect", "input_artifact_sha256", "output_artifact_sha256",
    "receipt_sha256", "raw_measurement_refs", "sealed_artifacts",
    "lifecycle_evidence_sha256", "execution_policy_requirements_sha256",
    "semantic_intent_sha256", "started_at", "finished_at", "settlement_state",
    "canonical_effect", "mathematical_effect", "strategy_effect"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "kind": {"const": "research_attempt_result_envelope"},
    "attempt_owner": {"const": "workstation_control"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "attempt_chain_id": {"$ref": "#/$defs/id"},
    "attempt_sequence": {"type": "integer", "minimum": 1},
    "retry_of_attempt_id": {"$ref": "#/$defs/nullableId"},
    "execution_intent_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "mission_id": {"$ref": "#/$defs/id"},
    "branch_id": {"$ref": "#/$defs/nullableId"},
    "strategy_id": {"$ref": "#/$defs/nullableId"},
    "context_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "semantic_work_unit_id": {"$ref": "#/$defs/id"},
    "configuration_id": {"$ref": "#/$defs/id"},
    "coordination_id": {"$ref": "#/$defs/id"},
    "coordination_digest": {"$ref": "#/$defs/sha256"},
    "authorization_id": {"$ref": "#/$defs/id"},
    "authorization_digest": {"$ref": "#/$defs/sha256"},
    "provider_fence_id": {"$ref": "#/$defs/id"},
    "provider_fence_digest": {"$ref": "#/$defs/sha256"},
    "provider_id": {"$ref": "#/$defs/id"},
    "provider_attempt_ref": {"$ref": "#/$defs/nullableString"},
    "termination_observation_contract": {
      "const": "wc.research_attempt_termination_observation.v1"
    },
    "termination_observation": {
      "oneOf": [
        {"$ref": "#/$defs/attemptTerminationObservation"},
        {"type": "null"}
      ]
    },
    "termination_observation_sha256": {"$ref": "#/$defs/nullableSha256"},
    "lifecycle": {"enum": ["prepared", "launch_requested", "running", "cancel_requested", "succeeded", "failed", "cancelled", "unknown", "fenced"]},
    "terminal": {"type": "boolean"},
    "late": {"type": "boolean"},
    "unknown_effect": {"type": "boolean"},
    "provider_effect": {"enum": ["none", "known_terminal", "unknown"]},
    "input_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "output_artifact_sha256": {"$ref": "#/$defs/nullableSha256"},
    "receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
    "raw_measurement_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/rawMeasurementRef"}
    },
    "sealed_artifacts": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/sealedArtifact"}
    },
    "lifecycle_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "execution_policy_requirements_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_intent_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"$ref": "#/$defs/nullableTimestamp"},
    "finished_at": {"$ref": "#/$defs/nullableTimestamp"},
    "settlement_state": {"enum": ["reserved", "eligible", "evidence_only", "blocked_unknown"]},
    "canonical_effect": {"const": "none"},
    "mathematical_effect": {"const": "none"},
    "strategy_effect": {"const": "none"}
  },
  "allOf": [
    {
      "if": {"properties": {"branch_id": {"type": "null"}}},
      "then": {"properties": {"strategy_id": {"type": "null"}}},
      "else": {"properties": {"strategy_id": {"$ref": "#/$defs/id"}}}
    },
    {
      "if": {"properties": {"strategy_id": {"type": "null"}}},
      "then": {"properties": {"branch_id": {"type": "null"}}},
      "else": {"properties": {"branch_id": {"$ref": "#/$defs/id"}}}
    },
    {
      "if": {"required": ["termination_observation_contract"]},
      "then": {
        "required": [
          "termination_observation_contract",
          "termination_observation",
          "termination_observation_sha256"
        ]
      }
    },
    {
      "if": {"required": ["termination_observation"]},
      "then": {
        "required": [
          "termination_observation_contract",
          "termination_observation",
          "termination_observation_sha256"
        ]
      }
    },
    {
      "if": {"required": ["termination_observation_sha256"]},
      "then": {
        "required": [
          "termination_observation_contract",
          "termination_observation",
          "termination_observation_sha256"
        ]
      }
    },
    {
      "if": {
        "required": ["termination_observation_contract"],
        "properties": {
          "lifecycle": {
            "enum": ["succeeded", "failed", "cancelled", "unknown", "fenced"]
          }
        }
      },
      "then": {
        "properties": {
          "termination_observation": {"$ref": "#/$defs/attemptTerminationObservation"},
          "termination_observation_sha256": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "if": {"required": ["termination_observation_contract"]},
        "then": {
          "properties": {
            "termination_observation": {"type": "null"},
            "termination_observation_sha256": {"type": "null"}
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nullableId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "nullableString": {"oneOf": [{"$ref": "#/$defs/nonEmptyString"}, {"type": "null"}]},
    "nullableTimestamp": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "attemptTerminationObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id", "chain_id", "attempt_sequence", "previous_attempt_id",
        "fence_id", "intent_id", "intent_digest", "intent_binding_digest",
        "journal_record_sha256", "event_history_sha256",
        "journal_schema_version", "attempt_state", "termination_class",
        "provider_effect_certainty", "cancellation_requested",
        "termination_event_sequence", "termination_event_sha256",
        "primary_observation_sequence", "primary_observation_sha256",
        "primary_provider_state", "late_observation_sequence",
        "late_observation_sha256", "late_provider_state"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "chain_id": {"$ref": "#/$defs/id"},
        "attempt_sequence": {"type": "integer", "minimum": 1},
        "previous_attempt_id": {"$ref": "#/$defs/nullableId"},
        "fence_id": {"$ref": "#/$defs/id"},
        "intent_id": {"$ref": "#/$defs/id"},
        "intent_digest": {"$ref": "#/$defs/sha256"},
        "intent_binding_digest": {"$ref": "#/$defs/sha256"},
        "journal_record_sha256": {"$ref": "#/$defs/sha256"},
        "event_history_sha256": {"$ref": "#/$defs/sha256"},
        "journal_schema_version": {"const": 5},
        "attempt_state": {
          "enum": ["succeeded", "failed", "cancelled", "unknown", "fenced"]
        },
        "termination_class": {
          "enum": [
            "provider_succeeded", "provider_failed", "provider_cancelled",
            "cancelled_before_effect", "provider_rejected_before_effect",
            "fenced_before_effect", "fenced_after_effect", "unknown_effect"
          ]
        },
        "provider_effect_certainty": {"enum": ["none", "known", "unknown"]},
        "cancellation_requested": {"type": "boolean"},
        "termination_event_sequence": {"type": "integer", "minimum": 1},
        "termination_event_sha256": {"$ref": "#/$defs/sha256"},
        "primary_observation_sequence": {"$ref": "#/$defs/nullablePositiveInteger"},
        "primary_observation_sha256": {"$ref": "#/$defs/nullableSha256"},
        "primary_provider_state": {"$ref": "#/$defs/nullableProviderState"},
        "late_observation_sequence": {"$ref": "#/$defs/nullablePositiveInteger"},
        "late_observation_sha256": {"$ref": "#/$defs/nullableSha256"},
        "late_provider_state": {"$ref": "#/$defs/nullableProviderState"}
      }
    },
    "nullablePositiveInteger": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "nullableProviderState": {
      "oneOf": [
        {"enum": ["succeeded", "failed", "cancelled"]},
        {"type": "null"}
      ]
    },
    "rawMeasurementRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "uri", "sha256", "byte_length"],
      "properties": {
        "kind": {"enum": ["events", "stdout", "stderr", "final_output", "metrics", "receipt", "process_control"]},
        "uri": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "sealedArtifact": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "path", "sha256", "size_bytes", "media_type", "encoding"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "encoding": {
          "oneOf": [
            {"$ref": "#/$defs/nonEmptyString"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
