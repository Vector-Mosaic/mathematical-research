{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector-mosaic.invalid/mathematical-research/canonical-commit-receipt.v1.schema.json",
  "title": "Mathematical Research Canonical Commit Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "contract_schema_sha256",
    "receipt_id",
    "transaction_id",
    "decision_ref",
    "case_ref",
    "candidate_ref",
    "full_rh_a1_binding_digest",
    "full_rh_a1_resolution_digest",
    "canonical_prestate",
    "canonical_poststate",
    "post_authority_vector_sha256",
    "changed_pointers",
    "writer_contract",
    "canonical_effect"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "canonical_commit_receipt"},
    "contract_schema_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"$ref": "#/$defs/stableId"},
    "transaction_id": {"$ref": "#/$defs/stableId"},
    "decision_ref": {"$ref": "#/$defs/decisionReference"},
    "case_ref": {"$ref": "#/$defs/caseReference"},
    "candidate_ref": {"$ref": "#/$defs/candidateReference"},
    "full_rh_a1_binding_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "full_rh_a1_resolution_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_prestate": {"$ref": "#/$defs/canonicalStateBinding"},
    "canonical_poststate": {"$ref": "#/$defs/canonicalStateBinding"},
    "post_authority_vector_sha256": {"$ref": "#/$defs/sha256"},
    "changed_pointers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "writer_contract": {"$ref": "#/$defs/writerContract"},
    "canonical_effect": {"const": "exact_authorized_delta"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,159}$"
    },
    "decisionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "digest_sha256"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/stableId"},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "caseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "digest_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/stableId"},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "revision", "digest_sha256"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/stableId"},
        "revision": {"type": "integer", "minimum": 1},
        "digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonicalStateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_path",
        "raw_sha256",
        "normalized_sha256",
        "schema_version",
        "validation_contract_sha256",
        "authority_context_sha256"
      ],
      "properties": {
        "repo_path": {
          "const": "projects/riemann_hypothesis/research_state.json"
        },
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "integer", "minimum": 1},
        "validation_contract_sha256": {"$ref": "#/$defs/sha256"},
        "authority_context_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "writerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writer_id", "writer_version", "writer_contract_sha256"],
      "properties": {
        "writer_id": {"const": "research_state.incumbent_whole_document_transaction"},
        "writer_version": {"const": 2},
        "writer_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
